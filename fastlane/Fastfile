default_platform(:ios)

API_KEY = app_store_connect_api_key(
  key_id:        "G389F99P3B",
  issuer_id:     "69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1",
  key_filepath:  "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_G389F99P3B.p8"
)

SCHEME       = "Duski"
PROJECT      = "Duski.xcodeproj"
BUNDLE_ID    = "info.cafferata.duski"
SCREENSHOTS  = "AppStore/Screenshots"

# AppStore/Screenshots/<locale>/<toestel>/<naam>.png → fastlane/screenshots_flat/<locale>/<toestel>-<naam>.png
def flat_screenshots
  root = File.expand_path("..", __dir__)
  dst  = File.join(root, "fastlane", "screenshots_flat")
  FileUtils.rm_rf(dst)
  Dir.glob(File.join(root, SCREENSHOTS, "*", "*", "*.png")).each do |f|
    locale, device = f.split("/")[-3], f.split("/")[-2]
    FileUtils.mkdir_p(File.join(dst, locale))
    FileUtils.cp(f, File.join(dst, locale, "#{device.gsub(/[^A-Za-z0-9.]+/, "_")}-#{File.basename(f)}"))
  end
  dst
end

platform :ios do

  # ─── TestFlight ────────────────────────────────────────────────────────────
  desc "Build en upload naar TestFlight"
  lane :beta do
    # Altijd hoogste TestFlight-build + 1. (Kaal increment_build_number nam het nummer
    # van de testtargets als basis en zette alles op 2 — 23 nov 2026.)
    increment_build_number(
      xcodeproj:    PROJECT,
      build_number: ([get_build_number(xcodeproj: PROJECT).to_i,
                     latest_testflight_build_number(api_key: API_KEY, app_identifier: BUNDLE_ID).to_i].max + 1).to_s
    )
    # Automatic signing + cloud-managed distribution via de Admin-key 5R3497VHF5
    # (Apple maakt/beheert het profiel automatisch). Vervangt de oude `match`-opzet,
    # waarvan het profiel na de Mac-herinstallatie niet meer geïnstalleerd was.
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{Dir.home}/.appstoreconnect/private_keys/AuthKey_5R3497VHF5.p8 " \
              "-authenticationKeyID 5R3497VHF5 " \
              "-authenticationKeyIssuerID 69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1",
      export_options: { signingStyle: "automatic", teamID: "9J2S23WJH3" }
    )
    upload_to_testflight(
      api_key: API_KEY,
      skip_waiting_for_build_processing: true
    )
  end

  # ─── App Store release ─────────────────────────────────────────────────────
  desc "Build, upload naar App Store en dien in ter beoordeling"
  lane :release do
    increment_build_number(
      xcodeproj:    PROJECT,
      build_number: ([get_build_number(xcodeproj: PROJECT).to_i,
                     latest_testflight_build_number(api_key: API_KEY, app_identifier: BUNDLE_ID).to_i].max + 1).to_s
    )
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )
    upload_to_app_store(
      api_key:                      API_KEY,
      submit_for_review:            true,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             false,
      screenshots_path:             SCREENSHOTS,
      metadata_path:                "fastlane/metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # ─── Alleen screenshots uploaden ───────────────────────────────────────────
  # deliver leest alleen PNG's direct in <locale>/, niet in toestel-submappen →
  # eerst plat neerzetten in fastlane/screenshots_flat (gitignored). Werkt op de
  # versie in voorbereiding (niet op de live versie). fastlane screenshots version:1.3
  desc "Upload screenshots naar de versie in voorbereiding"
  lane :screenshots do |o|
    upload_to_app_store(
      api_key:                              API_KEY,
      app_identifier:                       BUNDLE_ID,
      app_version:                          o[:version],
      skip_binary_upload:                   true,
      skip_metadata:                        true,
      skip_app_version_update:              true,
      overwrite_screenshots:                true,
      force:                                true,
      run_precheck_before_submit:           false,
      screenshots_path:                     flat_screenshots,
      ignore_language_directory_validation: true
    )
  end

  # ─── Alleen metadata uploaden (voor versie in voorbereiding) ──────────────
  desc "Upload beschrijving en release notes naar App Store Connect"
  lane :metadata do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata"
    )
  end

  # ─── Nieuwe versie klaarzetten (NIET indienen) ─────────────────────────────
  # fastlane prepare version:1.3 build:9 → maakt de versie aan, koppelt de build,
  # uploadt metadata + screenshots. Indienen blijft Eds klik in ASC, na de
  # pre-release-check (skill pre-release-app-review).
  desc "Versie aanmaken, build koppelen, metadata + screenshots uploaden (zonder indienen)"
  lane :prepare do |o|
    upload_to_app_store(
      api_key:                              API_KEY,
      app_identifier:                       BUNDLE_ID,
      app_version:                          o[:version],
      build_number:                         o[:build].to_s,
      skip_binary_upload:                   true,
      skip_screenshots:                     false,
      overwrite_screenshots:                true,
      screenshots_path:                     flat_screenshots,
      metadata_path:                        "fastlane/metadata",
      submit_for_review:                    false,
      automatic_release:                    false,
      force:                                true,
      run_precheck_before_submit:           false,
      ignore_language_directory_validation: true
    )
  end

  # ─── Alleen promotional tekst updaten (werkt op live versie) ───────────────
  desc "Update promotional tekst op de live versie"
  lane :promo do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      edit_live:                  true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata_promo"
    )
  end

  # ─── 1.2 indienen: reeds geuploade build 8 + ASO-metadata, voor review ─────
  desc "Versie 1.2 aanmaken, build 8 koppelen, metadata uploaden en indienen"
  lane :submit_12 do
    upload_to_app_store(
      api_key:                            API_KEY,
      app_identifier:                     BUNDLE_ID,
      app_version:                        "1.2",
      build_number:                       "8",
      skip_binary_upload:                 true,
      skip_screenshots:                   true,
      metadata_path:                      "fastlane/metadata",
      submit_for_review:                  true,
      automatic_release:                  false,
      force:                              true,
      run_precheck_before_submit:         false,
      precheck_include_in_app_purchases:  false,
      submission_information:             { add_id_info_uses_idfa: false }
    )
  end

end
