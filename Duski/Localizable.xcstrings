    "Abonnement is momenteel niet beschikbaar. Probeer het later opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo ist derzeit nicht verfügbar. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription is currently unavailable. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción no está disponible en este momento. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement est actuellement indisponible. Veuillez réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento non è al momento disponibile. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在サブスクリプションをご利用いただけません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura não está disponível no momento. Tente novamente mais tarde."
          }
        }
      }
    },
