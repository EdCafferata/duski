    "Het abonnement wordt automatisch elk jaar verlengd tegen %@, tenzij je het minstens 24 uur vóór het einde van de lopende periode opzegt via de abonnementsinstellingen van je Apple-account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch jedes Jahr zum Preis von %@, sofern du es nicht mindestens 24 Stunden vor Ablauf des laufenden Zeitraums in den Abo-Einstellungen deines Apple-Accounts kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription renews automatically every year at %@ unless you cancel at least 24 hours before the end of the current period in your Apple account’s subscription settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente cada año por %@, salvo que la canceles al menos 24 horas antes de que termine el periodo en curso desde los ajustes de suscripciones de tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement est renouvelé automatiquement chaque année au prix de %@, sauf si vous l’annulez au moins 24 heures avant la fin de la période en cours dans les réglages d’abonnement de votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente ogni anno a %@, salvo disdetta almeno 24 ore prima della fine del periodo in corso dalle impostazioni degli abbonamenti del tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、現在の期間が終了する24時間前までにAppleアカウントのサブスクリプション設定で解約しない限り、毎年%@で自動更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente todo ano por %@, a menos que você a cancele pelo menos 24 horas antes do fim do período atual nos ajustes de assinaturas da sua conta Apple."
          }
        }
      }
    },
    "Het abonnement wordt automatisch elke maand verlengd tegen %@, tenzij je het minstens 24 uur vóór het einde van de lopende periode opzegt via de abonnementsinstellingen van je Apple-account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch jeden Monat zum Preis von %@, sofern du es nicht mindestens 24 Stunden vor Ablauf des laufenden Zeitraums in den Abo-Einstellungen deines Apple-Accounts kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription renews automatically every month at %@ unless you cancel at least 24 hours before the end of the current period in your Apple account’s subscription settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente cada mes por %@, salvo que la canceles al menos 24 horas antes de que termine el periodo en curso desde los ajustes de suscripciones de tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement est renouvelé automatiquement chaque mois au prix de %@, sauf si vous l’annulez au moins 24 heures avant la fin de la période en cours dans les réglages d’abonnement de votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente ogni mese a %@, salvo disdetta almeno 24 ore prima della fine del periodo in corso dalle impostazioni degli abbonamenti del tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、現在の期間が終了する24時間前までにAppleアカウントのサブスクリプション設定で解約しない限り、毎月%@で自動更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente todo mês por %@, a menos que você a cancele pelo menos 24 horas antes do fim do período atual nos ajustes de assinaturas da sua conta Apple."
          }
        }
      }
    },
    "Het volume is begrensd en het toestel hoort minstens 2 meter van de baby vandaan te staan, volgens AAP-richtlijnen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke ist begrenzt, und das Gerät sollte gemäß den AAP-Empfehlungen mindestens 2 Meter vom Baby entfernt stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume is limited, and the device should be placed at least 2 metres (7 feet) from your baby, in line with AAP guidance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen está limitado y el dispositivo debe colocarse al menos a 2 metros del bebé, según las recomendaciones de la AAP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume est limité et l’appareil doit être placé à au moins 2 mètres du bébé, conformément aux recommandations de l’AAP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume è limitato e il dispositivo va tenuto ad almeno 2 metri dal bambino, secondo le raccomandazioni dell’AAP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量は制限されています。AAP（米国小児科学会）の指針に従い、デバイスは赤ちゃんから2メートル以上離して置いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume é limitado e o aparelho deve ficar a pelo menos 2 metros do bebê, conforme as recomendações da AAP."
          }
        }
      }
    },
