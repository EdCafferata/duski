<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Achtergrondaudio: zonder deze sleutel stopt iOS het geluid zodra het scherm vergrendelt.
	     Let op: INFOPLIST_KEY_UIBackgroundModes in de build settings wordt door Xcode NIET
	     in de gegenereerde Info.plist gezet; daarom staat het hier (wordt samengevoegd). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
